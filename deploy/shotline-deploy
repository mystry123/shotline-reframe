#!/usr/bin/env bash
# Root-owned entry point for deploys (installed at /usr/local/bin/shotline-deploy).
# The CI deployer may run only this through sudo; it validates the commit id
# and runs the repo's deploy.sh as the `reframe` user.
set -euo pipefail
sha="${1:-}"
[[ "$sha" =~ ^[0-9a-f]{7,40}$ ]] || { echo "usage: shotline-deploy <commit-sha>" >&2; exit 2; }
cd /opt/shotline-reframe
exec sudo -u reframe -H /opt/shotline-reframe/app/deploy.sh "$sha"
