# /etc/shotline-reframe/env (root:reframe, mode 640). Template only: real
# values live on the VM. Do not set GOOGLE_APPLICATION_CREDENTIALS: Vertex AI
# uses the VM's attached service account through the metadata server.
REFRAME_SERVICE_TOKEN=generate-with-openssl-rand-hex-32
REFRAME_ALLOWED_HOSTS=your-bucket.s3.ap-south-1.amazonaws.com
REFRAME_CACHE_DIR=/var/lib/shotline-reframe/cache
REFRAME_WORKERS=1
REFRAME_HOST=127.0.0.1   # only Caddy (HTTPS on 443) reaches the service
REFRAME_PORT=8090

DIRECTOR_PROVIDER=gemini
DIRECTOR_MODEL=gemini-3.8-flash
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=shotline-511017
GOOGLE_CLOUD_LOCATION=global
